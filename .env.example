# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Cloudinary Configuration
CLOUDINARY_URL=your_cloudinary_url_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Watermark and Brand Logo settings
CLOUDINARY_WATERMARK_PUBLIC_ID=pawtraits_watermark_logo
CLOUDINARY_WATERMARK_OPACITY=20
CLOUDINARY_BRAND_LOGO_PUBLIC_ID=pawtraits_brand_logo

# QR Code settings  
QR_CODE_BASE_URL=https://pawtraits.com/shop
QR_CODE_DEFAULT_DISCOUNT=10

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Instagram OAuth Configuration (optional - for advanced sharing features)
# INSTAGRAM_CLIENT_ID=your_instagram_client_id
# INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
# Sticker QR codes (docs/specs/qr-stickers.md)
# Base for printed short links — keep it short; QR is generated in upper case
NEXT_PUBLIC_SHORT_LINK_BASE=https://pawtraits.pics
# HMAC key for the pt_qr attribution cookie (generate: openssl rand -base64 32)
QR_ATTRIBUTION_SECRET=
# Salt for hashing scanner IPs (generate: openssl rand -base64 16)
QR_IP_SALT=

# Marketing & analytics (loaded only after cookie consent — components/tracking)
NEXT_PUBLIC_GA4_ID=                     # G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=              # AW-XXXXXXXXXX (optional, for remarketing/conversions)
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=  # conversion label for purchases (optional)
NEXT_PUBLIC_META_PIXEL_ID=              # Meta (Facebook/Instagram) Pixel id
META_CAPI_ACCESS_TOKEN=                 # Meta Conversions API token (server-side Purchase)
META_CAPI_TEST_EVENT_CODE=              # optional, for testing in Events Manager

# Signed links for purchased digital downloads in emails (openssl rand -base64 32)
DOWNLOAD_LINK_SECRET=
